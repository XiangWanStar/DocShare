# 复制为 .env 并修改（可选，不配置则使用默认值）

# 数据库（默认 ./data/app.db，无需修改）
# DATABASE_URL=sqlite:///./data/app.db

# 本地存储目录（默认 ./data）
# DATA_DIR=./data

# JWT 密钥：不设置会自动生成并保存到 data/.jwt_secret
JWT_SECRET=please-change-me-to-a-long-random-string

# 应用对外可访问地址。
# 留空：自动使用当前请求地址（仅适合本机联调，OnlyOffice 与后端同机时可用）
# Docker 部署：OnlyOffice 容器内无法访问 localhost，必须配置为局域网 IP 或域名
# 例如 http://192.168.1.100:8000 或 https://your-domain.com
# PUBLIC_BASE_URL=http://localhost:8000

# OnlyOffice Document Server 地址（前端加载编辑器用）
ONLYOFFICE_URL=http://localhost:8080
ONLYOFFICE_JWT_ENABLED=true
ONLYOFFICE_JWT_SECRET=please-change-me-too

# 调试模式
# DEBUG=true